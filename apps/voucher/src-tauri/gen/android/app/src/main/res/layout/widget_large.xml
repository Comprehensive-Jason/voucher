<?xml version="1.0" encoding="utf-8"?>
<!-- Voucher widget, large 2x3 and taller. Filled in by VoucherWidget.kt. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@drawable/widget_bg" android:padding="14dp">
    <LinearLayout android:layout_width="wrap_content" android:layout_height="40dp" android:orientation="horizontal" android:gravity="bottom">
        <TextView android:id="@+id/val" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="34sp" android:textStyle="bold" android:fontFamily="monospace" android:textColor="#F2F2F0" android:includeFontPadding="false" />
        <TextView android:id="@+id/unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" android:fontFamily="monospace" android:textColor="#A3A8AD" android:layout_marginStart="4dp" android:includeFontPadding="false" />
    </LinearLayout>
    <TextView android:id="@+id/label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#A3A8AD" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="4dp" />
    <TextView android:id="@+id/label2" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#A3A8AD" android:maxLines="1" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="6dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="0dp">
            <ImageView android:id="@+id/cell0" android:layout_width="0dp" android:layout_height="9dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:src="@drawable/widget_cell" />
            <ImageView android:id="@+id/cell1" android:layout_width="0dp" android:layout_height="9dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:src="@drawable/widget_cell" />
            <ImageView android:id="@+id/cell2" android:layout_width="0dp" android:layout_height="9dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:src="@drawable/widget_cell" />
            <ImageView android:id="@+id/cell3" android:layout_width="0dp" android:layout_height="9dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:src="@drawable/widget_cell" />
            <ImageView android:id="@+id/cell4" android:layout_width="0dp" android:layout_height="9dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:src="@drawable/widget_cell" />
            <ImageView android:id="@+id/cell5" android:layout_width="0dp" android:layout_height="9dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:src="@drawable/widget_cell" />
            <ImageView android:id="@+id/cell6" android:layout_width="0dp" android:layout_height="9dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:src="@drawable/widget_cell" />
            <ImageView android:id="@+id/cell7" android:layout_width="0dp" android:layout_height="9dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:src="@drawable/widget_cell" />
            <ImageView android:id="@+id/cell8" android:layout_width="0dp" android:layout_height="9dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:src="@drawable/widget_cell" />
            <ImageView android:id="@+id/cell9" android:layout_width="0dp" android:layout_height="9dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:src="@drawable/widget_cell" />
            <ImageView android:id="@+id/cell10" android:layout_width="0dp" android:layout_height="9dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:src="@drawable/widget_cell" />
            <ImageView android:id="@+id/cell11" android:layout_width="0dp" android:layout_height="9dp" android:layout_weight="1" android:layout_marginEnd="0dp" android:src="@drawable/widget_cell" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="3dp">
            <ImageView android:id="@+id/cell12" android:layout_width="0dp" android:layout_height="9dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:src="@drawable/widget_cell" />
            <ImageView android:id="@+id/cell13" android:layout_width="0dp" android:layout_height="9dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:src="@drawable/widget_cell" />
            <ImageView android:id="@+id/cell14" android:layout_width="0dp" android:layout_height="9dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:src="@drawable/widget_cell" />
            <ImageView android:id="@+id/cell15" android:layout_width="0dp" android:layout_height="9dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:src="@drawable/widget_cell" />
            <ImageView android:id="@+id/cell16" android:layout_width="0dp" android:layout_height="9dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:src="@drawable/widget_cell" />
            <ImageView android:id="@+id/cell17" android:layout_width="0dp" android:layout_height="9dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:src="@drawable/widget_cell" />
            <ImageView android:id="@+id/cell18" android:layout_width="0dp" android:layout_height="9dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:src="@drawable/widget_cell" />
            <ImageView android:id="@+id/cell19" android:layout_width="0dp" android:layout_height="9dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:src="@drawable/widget_cell" />
            <ImageView android:id="@+id/cell20" android:layout_width="0dp" android:layout_height="9dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:src="@drawable/widget_cell" />
            <ImageView android:id="@+id/cell21" android:layout_width="0dp" android:layout_height="9dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:src="@drawable/widget_cell" />
            <ImageView android:id="@+id/cell22" android:layout_width="0dp" android:layout_height="9dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:src="@drawable/widget_cell" />
            <ImageView android:id="@+id/cell23" android:layout_width="0dp" android:layout_height="9dp" android:layout_weight="1" android:layout_marginEnd="0dp" android:src="@drawable/widget_cell" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
        <TextView android:id="@+id/goal" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="12sp" android:textColor="#FFB547" />
        <TextView android:id="@+id/streak" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#FFB547" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="NEXT VOUCHER" android:textSize="10sp" android:letterSpacing="0.12" android:fontFamily="monospace" android:textColor="#A3A8AD" android:layout_marginTop="10dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="10dp">
        <LinearLayout android:id="@+id/bar0" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="6dp">
            <TextView android:id="@+id/bar0_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#F2F2F0" android:maxLines="1" android:ellipsize="end" />
            <ProgressBar android:id="@+id/bar0_fill" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="4dp" android:max="100" android:progressDrawable="@drawable/widget_bar" />
        </LinearLayout>
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
        <LinearLayout android:id="@+id/bar1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="6dp">
            <TextView android:id="@+id/bar1_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#F2F2F0" android:maxLines="1" android:ellipsize="end" />
            <ProgressBar android:id="@+id/bar1_fill" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="4dp" android:max="100" android:progressDrawable="@drawable/widget_bar" />
        </LinearLayout>
        </FrameLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="10dp">
        <LinearLayout android:id="@+id/bar2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="6dp">
            <TextView android:id="@+id/bar2_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#F2F2F0" android:maxLines="1" android:ellipsize="end" />
            <ProgressBar android:id="@+id/bar2_fill" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="4dp" android:max="100" android:progressDrawable="@drawable/widget_bar" />
        </LinearLayout>
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
        <LinearLayout android:id="@+id/bar3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="6dp">
            <TextView android:id="@+id/bar3_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#F2F2F0" android:maxLines="1" android:ellipsize="end" />
            <ProgressBar android:id="@+id/bar3_fill" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="4dp" android:max="100" android:progressDrawable="@drawable/widget_bar" />
        </LinearLayout>
        </FrameLayout>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="This week" android:textSize="12sp" android:textColor="#A3A8AD" />
        <TextView android:id="@+id/week" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:fontFamily="monospace" android:textColor="#F2F2F0" />
    </LinearLayout>
    <TextView android:id="@+id/button" android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center" android:textSize="13sp" android:textStyle="bold" android:background="@drawable/widget_button" />
</LinearLayout>
