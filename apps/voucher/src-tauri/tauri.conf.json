{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voucher",
  "version": "0.1.0",
  "identifier": "io.github.comprehensivejason.voucher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Voucher",
        "width": 1280,
        "height": 800,
        "minWidth": 390,
        "minHeight": 600,
        "backgroundColor": "#0e0f11"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
